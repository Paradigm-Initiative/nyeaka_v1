generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum Role {
  REQUESTER
  DONOR
  BOTH
  GUEST
  ADMIN
}

enum VerificationStatus {
  NONE
  PENDING
  SUBMITTED
  VERIFIED
  FAILED
}

enum RequestOfferStatus {
  ACTIVE
  MATCHED
  CLOSED
  EXPIRED
}

enum DeviceType {
  LAPTOP
  TABLET
  SMARTPHONE
  DESKTOP
  OTHER
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum MatchStatus {
  ACTIVE
  HANDED_OVER
  CANCELLED
}

enum ReportTargetType {
  USER
  LISTING
  REQUEST
  MESSAGE
}

enum ReportReason {
  SPAM
  SCAM
  INAPPROPRIATE
  HARASSMENT
  MISREPRESENTED_DEVICE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

enum IdDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

enum OperatingSystem {
  WINDOWS
  MACOS
  LINUX
  ANDROID
  IOS
  CHROMEOS
  OTHER
}

model User {
  id                   String             @id @default(uuid(7))
  email                String             @unique
  emailVerified        Boolean            @default(false)
  firstName            String
  lastName             String
  image                String?
  phone                String?
  phoneVerified        Boolean            @default(false)
  country              String?
  countryCode          String?
  role                 Role               @default(GUEST)
  bio                  String?
  idVerified           Boolean            @default(false)
  idVerificationStatus VerificationStatus @default(NONE)
  createdAt            DateTime           @default(now())
  lastLogin            DateTime?
  updatedAt            DateTime           @updatedAt

  requests Request[]
  listings Listing[]
  name     String
  sessions Session[]
  accounts Account[]

  donorMatches     Match[]          @relation("MatchDonor")
  requesterMatches Match[]          @relation("MatchRequester")
  sentMessages     Message[]
  ratingsGiven     Rating[]         @relation("RatingRater")
  ratingsReceived  Rating[]         @relation("RatingRatee")
  reportsFiled     Report[]         @relation("ReportReporter")
  reportsAgainst   Report[]         @relation("ReportTargetUser")
  blocksMade       Block[]          @relation("BlockBlocker")
  blocksReceived   Block[]          @relation("BlockBlocked")
  idVerifications  IdVerification[]
  offersAsDonor    Offer[]          @relation("OfferDonor")
  offersInitiated  Offer[]          @relation("OfferInitiator")

  @@map("user")
}

model Request {
  id             String             @id @default(uuid(7))
  requesterId    String
  requester      User               @relation(fields: [requesterId], references: [id])
  title          String
  description    String
  deviceType     DeviceType? // moved here from only being on Listing
  preferredBrand String?
  isUrgent       Boolean            @default(false)
  countryCode    String
  city           String
  area           String?
  minCondition   Condition?
  status         RequestOfferStatus @default(ACTIVE)
  expiresAt      DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  spec    RequestSpec?
  offers  Offer[]
  matches Match[]
  reports Report[]

  @@index([requesterId])
  @@index([status])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Request_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Request_description_trgm_idx")
}

model RequestSpec {
  id        String  @id @default(uuid(7))
  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // Minimum acceptable specs — all optional, requester fills what matters to them
  minRam             Int? // in GB e.g. 8
  minStorage         Int? // in GB e.g. 256
  minYear            Int? // manufacture year e.g. 2018
  preferredOs        OperatingSystem?
  minScreenSize      Float? // in inches e.g. 13.3
  preferredProcessor String? // e.g. "Intel i5", "Apple M1"
  needsCamera        Boolean?
  needsMicrophone    Boolean?
  needsKeyboard      Boolean? // relevant for tablets
  needsCharger       Boolean?
  notes              String? // any extra requirements in free text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id          String             @id @default(uuid(7))
  donorId     String
  donor       User               @relation(fields: [donorId], references: [id])
  deviceType  DeviceType
  title       String
  description String
  brand       String
  model       String
  condition   Condition
  photos      String[]
  countryCode String
  city        String
  area        String?
  status      RequestOfferStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  spec    DeviceSpec?
  offers  Offer[]
  matches Match[]
  reports Report[]

  @@index([donorId])
  @@index([status])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Listing_title_trgm_idx")
  @@index([brand(ops: raw("gin_trgm_ops"))], type: Gin, map: "Listing_brand_trgm_idx")
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin, map: "Listing_model_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Listing_description_trgm_idx")
}

model DeviceSpec {
  id        String  @id @default(uuid(7))
  listingId String  @unique
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Actual specs of the physical device
  ram           Int? // in GB e.g. 8
  storage       Int? // in GB e.g. 256
  year          Int? // manufacture year e.g. 2020
  os            OperatingSystem?
  screenSize    Float? // in inches e.g. 15.6
  processor     String? // e.g. "Intel i5-10th Gen"
  color         String?
  hasCamera     Boolean?
  hasMicrophone Boolean?
  hasKeyboard   Boolean? // relevant for tablets
  hasCharger    Boolean? // does the donation include a charger
  notes         String? // any extra details

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Offer {
  id        String      @id @default(uuid(7))
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requestId String
  request   Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Denormalised from listing.donorId so "one PENDING offer per donor and request"
  // can be a partial unique index (see the offer_donor_and_match_handoff migration).
  donorId       String
  donor         User   @relation("OfferDonor", fields: [donorId], references: [id])
  // Who sent the offer: the donor (offering a device) or the requester (asking for one).
  // The other party is the one who can accept or decline.
  initiatedById String
  initiatedBy   User   @relation("OfferInitiator", fields: [initiatedById], references: [id])
  message   String?
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  match Match?

  @@unique([listingId, requestId])
  @@index([requestId])
  @@index([donorId])
  @@index([initiatedById, createdAt])
  @@index([status])
}

model Match {
  id           String      @id @default(uuid(7))
  offerId      String      @unique
  offer        Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  donorId      String
  donor        User        @relation("MatchDonor", fields: [donorId], references: [id])
  requesterId  String
  requester    User        @relation("MatchRequester", fields: [requesterId], references: [id])
  listingId    String
  listing      Listing     @relation(fields: [listingId], references: [id])
  requestId    String
  request      Request     @relation(fields: [requestId], references: [id])
  status       MatchStatus @default(ACTIVE)
  // Each side opts in to sharing their phone number with the other.
  donorSharedPhone       Boolean   @default(false)
  requesterSharedPhone   Boolean   @default(false)
  // Handoff is complete (HANDED_OVER) once both sides have confirmed.
  donorConfirmedAt       DateTime?
  requesterConfirmedAt   DateTime?
  handedOverAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  conversation Conversation?
  ratings      Rating[]

  @@index([donorId])
  @@index([requesterId])
  @@index([status])
}

model Conversation {
  id        String   @id @default(uuid(7))
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model Message {
  id             String       @id @default(uuid(7))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  reports Report[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Rating {
  id        String   @id @default(uuid(7))
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation("RatingRater", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("RatingRatee", fields: [rateeId], references: [id])
  score     Int // 1-5, enforced in the app and by a CHECK constraint
  comment   String?
  createdAt DateTime @default(now())

  @@unique([matchId, raterId])
  @@index([rateeId])
}

model Report {
  id              String           @id @default(uuid(7))
  reporterId      String
  reporter        User             @relation("ReportReporter", fields: [reporterId], references: [id])
  targetType      ReportTargetType
  targetUserId    String?
  targetUser      User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id])
  targetListingId String?
  targetListing   Listing?         @relation(fields: [targetListingId], references: [id], onDelete: SetNull)
  targetRequestId String?
  targetRequest   Request?         @relation(fields: [targetRequestId], references: [id], onDelete: SetNull)
  targetMessageId String?
  targetMessage   Message?         @relation(fields: [targetMessageId], references: [id], onDelete: SetNull)
  reason          ReportReason
  details         String?
  status          ReportStatus     @default(OPEN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([reporterId])
}

model Block {
  id        String   @id @default(uuid(7))
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model IdVerification {
  id              String             @id @default(uuid(7))
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    IdDocumentType
  providerRef     String? // reference at the verification provider; no ID images are stored here
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}
